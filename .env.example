# Ask TabDump / Gemini configuration
# Get a key at https://aistudio.google.com/apikey — never commit your real key.
GEMINI_API_KEY=

# Optional overrides (sane defaults are baked in if omitted). Verify these
# against https://ai.google.dev/gemini-api/docs/models for your account
# before relying on the defaults — model availability/pricing changes.
#
# GEMINI_CHAT_MODEL — streaming chat + the tool-calling agent loop (needs a
# full Flash-tier model's reasoning/tool-use quality).
# GEMINI_CHAT_MODEL=gemini-3.6-flash
#
# GEMINI_EMBEDDING_MODEL — semantic search indexing.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
#
# GEMINI_ANALYSIS_MODEL — single-shot "Understand this collection"/"Find
# gaps" JSON generation. Deliberately defaults to a Flash-Lite model rather
# than the chat model: Flash-Lite gets its own separate free-tier daily
# quota bucket from Flash, so these calls don't compete with chat/agent
# traffic for the same quota, on top of being cheaper per token.
# GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite

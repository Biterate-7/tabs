{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hubble",
  "mainBinaryName": "Hubble",
  "version": "0.1.0",
  "identifier": "app.tabdump.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:export"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://hubble-hq.vercel.app",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hubble"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Hubble",
    "category": "Productivity",
    "shortDescription": "One connected workspace for everything you learn with AI.",
    "longDescription": "Hubble keeps what you learn in AI apps, with the pages and notes behind it, in searchable projects you can reuse in your next AI chat. Your projects stay on this device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "upgradeCode": "778d87a8-77ea-516f-b314-46696aa85a7c"
      }
    }
  }
}

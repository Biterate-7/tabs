{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tabdump-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tabdump-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "hubble-dev-webpack",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--webpack",
        "-p",
        "3291"
      ],
      "port": 3291
    }
  ]
}
